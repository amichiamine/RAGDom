# RAGDom — configuration OPTIONNELLE (tous les chemins ont des défauts relatifs au projet).
# Copier en .env pour personnaliser. Défauts : <racine>/sources, /databases, /models, /engines…
#SOURCES_DIR=c:/xampp/htdocs/RAGDom/sources
#DATABASES_DIR=c:/xampp/htdocs/RAGDom/databases
#PIPELINE_SET_DIR=c:/xampp/htdocs/RAGDom/pipeline_set
#MODELS_DIR=c:/xampp/htdocs/RAGDom/models
#ENGINES_DIR=c:/xampp/htdocs/RAGDom/engines
#CONFIG_DB_PATH=c:/xampp/htdocs/RAGDom/backend/ragdom_config.sqlite
#BACKEND_PORT=8000
#FRONTEND_URL=http://localhost:5173
#MAX_RAM_MB=2048
#RAGDOM_OFFLINE=false
# Web uniquement :
#RAGDOM_READONLY=false
#RAGDOM_AUTH_TOKEN=
#RAGDOM_ASK_RATE_PER_MIN=0
