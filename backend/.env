# ══════════════════════════════════════════════════════════════════════════
# RAGDom — Configuration (.env) — PRÉ-REMPLI, prêt à l'emploi
# ══════════════════════════════════════════════════════════════════════════
# CE FICHIER EST OPTIONNEL : sans lui, RAGDom déduit tout de l'arborescence
# du projet. Il sert à PERSONNALISER. Chaque ligne commentée (#) = défaut actif.
# Pour changer une valeur : décommenter la ligne et la modifier.
# ⚠️ NE JAMAIS mettre de secrets ici si le dépôt est public (utiliser les
#    variables d'environnement de l'hébergeur pour RAGDOM_AUTH_TOKEN et les clés).

# ── Dossiers physiques (défauts : sous la racine du projet) ──────────────────
# Où déposer les PDF sources (arborescence Matière/Niveau, ex. sources/Maths/1AM/)
#SOURCES_DIR=c:/xampp/htdocs/RAGDom/sources
# Où vivent les bibliothèques .sqlite (auto-détectées à chaque affichage)
#DATABASES_DIR=c:/xampp/htdocs/RAGDom/databases
# Fichiers de travail du pipeline (checkpoints temporaires)
#PIPELINE_SET_DIR=c:/xampp/htdocs/RAGDom/pipeline_set
# Modèles OCR/embeddings téléchargés au 1er lancement (RAGDOM_OFFLINE=false)
#MODELS_DIR=c:/xampp/htdocs/RAGDom/models
# Moteurs d'extraction (sci-engine + futurs moteurs déposés ici)
#ENGINES_DIR=c:/xampp/htdocs/RAGDom/engines
# Base de configuration système (clés LLM, réglages, comptes)
#CONFIG_DB_PATH=c:/xampp/htdocs/RAGDom/backend/ragdom_config.sqlite

# ── Serveur ──────────────────────────────────────────────────────────────────
# Port de l'API (npm run dev bascule automatiquement s'il est occupé)
#BACKEND_PORT=8000
# Origine(s) autorisées CORS, séparées par des virgules
#FRONTEND_URL=http://localhost:5173

# ── Pipeline ─────────────────────────────────────────────────────────────────
# Plafond mémoire du pipeline (Mo) — arbitrage D2-B
#MAX_RAM_MB=2048
# true = interdit tout téléchargement de modèles (environnement hermétique)
#RAGDOM_OFFLINE=false
# Timeout des appels VLM (secondes)
#VLM_TIMEOUT_SECONDS=30

# ── LLM local ────────────────────────────────────────────────────────────────
#OLLAMA_BASE_URL=http://localhost:11434

# ── Web uniquement (à définir chez l'hébergeur, PAS ici si dépôt public) ─────
# true = mode consultation : les routes d'administration n'existent pas (404)
#RAGDOM_READONLY=false
# Jeton d'amorçage admin (création du 1er compte sur un déploiement web)
#RAGDOM_AUTH_TOKEN=
# Quota chat RAG par IP/minute (0 = désactivé)
#RAGDOM_ASK_RATE_PER_MIN=0
# false = interdit la lecture en clair des clés LLM (OBLIGATOIRE sur le web)
#RAGDOM_ALLOW_REVEAL=true
# Parallélisme intra-page (post-v1, D4-B) : 1 = séquentiel strict
#RAGDOM_INTRA_PAGE_WORKERS=1

# ── Seed des clés LLM au démarrage (déploiements web, disque éphémère) ────────
# Entrées séparées par des virgules : provider:clé ou provider:clé:modèle.
# À chaque démarrage, les entrées absentes sont insérées dans ragdom_config.sqlite
# et le provider est activé. NE JAMAIS committer de vraies clés dans le dépôt —
# définissez cette variable dans l'environnement de l'hébergeur (Render > Environment).
# Exemple : RAGDOM_SEED_LLM_KEYS=gemini:AIza...:gemini-2.5-flash,groq:gsk_...
RAGDOM_SEED_LLM_KEYS=

# ── OCR de page entière par VLM (Tier 2, D3-B) ───────────────────────────────
# auto (défaut) : pages SCANNÉES → transcription par le provider LLM vision
# configuré (rotation de clés), repli RapidOCR hors-ligne ; pages natives →
# seulement si le texte extrait est illisible (police non-Unicode).
# false : désactive totalement (Tier 1 seul).
RAGDOM_VLM_PAGE_OCR=auto
