{
  "name": "ragdom",
  "private": true,
  "version": "3.5.0",
  "description": "RAGDom — lancement unifié : `npm install` puis `npm run dev` depuis la racine",
  "scripts": {
    "setup": "npm --prefix frontend install && node scripts/dev-backend.mjs --setup",
    "fetch:dbs": "node scripts/fetch_published_dbs.mjs",
    "dev": "concurrently -k -n api,ui -c blue,green \"node scripts/dev-backend.mjs\" \"npm --prefix frontend run dev\"",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "node scripts/dev-backend.mjs --no-reload",
    "test:backend": "node scripts/dev-backend.mjs --pytest"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
